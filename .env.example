# ============================================================
# Smart Student Bus — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# GPS Update Interval (milliseconds — default 5000)
NEXT_PUBLIC_GPS_UPDATE_INTERVAL=5000

# GPS Proximity Threshold for QR boarding validation (meters — default 100)
NEXT_PUBLIC_GPS_PROXIMITY_THRESHOLD=100
